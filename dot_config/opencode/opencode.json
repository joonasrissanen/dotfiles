{
  "instructions": [],
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "mcp_timeout": 60000
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.cer": "deny",
      "*.crt": "deny",
      "*/.ssh/*": "deny",
      "*secret*": "deny",
      "*credential*": "deny"
    },
    "external_directory": {
      "/tmp": "allow",
      "/tmp/**": "allow",
      "/private/tmp": "allow",
      "/private/tmp/**": "allow",
      "~/.herdr": "allow",
      "~/.herdr/**": "allow"
    },
    "edit": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*/.ssh/*": "deny"
    },
    "bash": {
      "*": "allow",
      "docker push *": "ask",
      "kubectl apply *": "ask",
      "kubectl delete *": "ask",
      "kubectl scale *": "ask",
      "kubectl exec *": "ask",
      "kubectl patch *": "ask",
      "kubectl rollout *": "ask",
      "terraform apply *": "ask",
      "terraform destroy *": "ask",
      "terraform import *": "ask",
      "gh pr comment *": "ask",
      "gh pr merge *": "ask",
      "gh pr close *": "ask",
      "gh pr review *": "ask",
      "gh pr edit *": "ask",
      "gh issue create *": "ask",
      "gh issue edit *": "ask",
      "gh issue close *": "ask",
      "gh release create *": "ask",
      "gh release edit *": "ask",
      "gh release delete *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "glab mr merge *": "ask",
      "glab mr close *": "ask",
      "glab mr create *": "ask",
      "glab mr update *": "ask",
      "glab issue create *": "ask",
      "glab issue close *": "ask",
      "glab issue update *": "ask",
      "glab release create *": "ask",
      "glab release delete *": "ask",
      "az *": "ask"
    }
  },
  "mcp": {
    "datadog.eu": {
      "type": "remote",
      "url": "https://mcp.datadoghq.eu/v1/mcp",
      "oauth": {}
    },
    "datadog.us": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/v1/mcp",
      "oauth": {}
    },
    "kubernetes": {
      "type": "local",
      "command": ["bun", "x", "kubernetes-mcp-server@latest"]
    },
    "azure": {
      "type": "local",
      "command": ["bun", "x", "@azure/mcp@latest", "server", "start"]
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "oauth": {}
    },
    "terraform": {
      "type": "local",
      "command": ["terraform-mcp-server"],
      "environment": {
        "TFE_TOKEN": "{env:TFE_TOKEN}"
      }
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "redirectUri": "http://localhost:3118/callback"
      }
    },
    "prometheus": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "PROMETHEUS_URL",
        "ghcr.io/pab1it0/prometheus-mcp-server:latest"
      ],
      "environment": {
        "PROMETHEUS_URL": "https://promxy.example.com/"
      }
    }
  }
}
