{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "mcp_timeout": 60000
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.cer": "deny",
      "*.crt": "deny",
      "*/.ssh/*": "deny",
      "*secret*": "deny",
      "*credential*": "deny"
    },
    "edit": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*/.ssh/*": "deny"
    },
    "bash": {
      "*": "allow",
      "terraform": "ask",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "xargs *": "allow",
      "go *": "allow",
      "mise *": "allow",
      "git commit *": "deny",
      "git push *": "deny"
    }
  },
  "mcp": {
    "datadog.eu": {
      "type": "remote",
      "url": "https://mcp.datadoghq.eu/api/unstable/mcp-server/mcp",
      "oauth": {}
    },
    "datadog.us": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp",
      "oauth": {}
    },
    "kubernetes": {
      "type": "local",
      "command": ["bun", "x", "kubernetes-mcp-server@latest"]
    },
    "azure": {
      "type": "local",
      "command": ["bun", "x", "@azure/mcp@latest", "server", "start"]
    },
    "gitlab": {
      "type": "local",
      "command": ["bun", "x", "@zereight/mcp-gitlab"],
      "environment": {
        "GITLAB_API_URL": "https://gitlab.relexsolutions.com/api/v4",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "{env:GITLAB_TOKEN}"
      }
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "oauth": {}
    },
    "terraform": {
      "type": "local",
      "command": ["terraform-mcp-server"],
      "environment": {
        "TFE_TOKEN": "{env:TFE_TOKEN}"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "redirectUri": "http://localhost:3118/callback"
      }
    },
    "prometheus": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "PROMETHEUS_URL",
        "ghcr.io/pab1it0/prometheus-mcp-server:latest"
      ],
      "environment": {
        "PROMETHEUS_URL": "https://promxy.prod-eu.prod.ia.relexsolutions.com/"
      }
    }
  }
}
